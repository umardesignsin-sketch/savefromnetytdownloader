{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "savefromnet-funyt",
  "main": "src/worker.js",
  "compatibility_date": "2026-10-06",
  "workers_dev": true,
  "assets": {
    "directory": "./dist",
    "html_handling": "drop-trailing-slash",
    "not_found_handling": "404-page",
    "run_worker_first": ["/api/*", "/analytics*", "/healthz"]
  },
  "analytics_engine_datasets": [
    { "binding": "EVENTS", "dataset": "savefromnet_events" }
  ],
  "routes": [
    { "pattern": "savefromnet.fun/*", "zone_id": "1d7a01394100b39232e2f8a8b5380d78" }
  ],
  "containers": [
    {
      "class_name": "DownloaderContainer",
      "image": "registry.cloudflare.com/e216b35633d32ecc2a61a21369976716/savefromnet-final:46f8c1ee02a4d5ba1233c28cb075eba0a77e8b2f",
      "instance_type": "basic",
      "max_instances": 1
    }
  ],
  "durable_objects": {
    "bindings": [
      { "name": "DOWNLOADER", "class_name": "DownloaderContainer" },
      { "name": "VISITOR_ANALYTICS", "class_name": "VisitorAnalytics" }
    ]
  },
  "ratelimits": [
    {
      "name": "DOWNLOAD_LIMIT",
      "namespace_id": "157802",
      "simple": { "limit": 2, "period": 60 }
    },
    {
      "name": "ANALYZE_LIMIT",
      "namespace_id": "157803",
      "simple": { "limit": 8, "period": 60 }
    },
    {
      "name": "EVENT_LIMIT",
      "namespace_id": "157804",
      "simple": { "limit": 30, "period": 60 }
    },
    {
      "name": "FILE_LIMIT",
      "namespace_id": "157805",
      "simple": { "limit": 4, "period": 60 }
    }
  ],
  "exports": {
    "DownloaderContainer": { "type": "durable-object", "storage": "sqlite" },
    "VisitorAnalytics": { "type": "durable-object", "storage": "sqlite" }
  }
}
